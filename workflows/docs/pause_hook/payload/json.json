{
  "name": "kilroy.docs/docs/pause_hook",
  "version": "1",
  "description": "Pause web widget — no-op",
  "isInteractive": false,
  "clean_up": true,
  "inputs": [],
  "outputs": ["webwidget_close_event", "webwidget_lifecycle_state"],
  "args": {"role": "*"},
  "steps": [
    {
      "operation": "set_value",
      "isServer": true,
      "args": {"variable": "wfCleanupFlag", "value": "1"}
    },
    {
      "operation": "step_group",
      "isServer": true,
      "args": {
        "role": "*",
        "message": "",
        "timer": "24",
        "isInteractive": false,
        "canTerminate": false,
        "success": []
      }
    },
    {
      "operation": "end",
      "isServer": true,
      "args": null
    }
  ],
  "externalForms": {}
}
