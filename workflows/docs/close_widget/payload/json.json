{
  "name": "kilroy.docs/docs/close_widget",
  "version": "1",
  "description": "Stop and close this web widget PD",
  "isInteractive": false,
  "clean_up": true,
  "inputs": [],
  "outputs": ["webwidget_close_event", "webwidget_lifecycle_state"],
  "args": {"role": "*"},
  "steps": [
    {
      "operation": "set_value",
      "isServer": true,
      "args": {"variable": "wfCleanupFlag", "value": "1"}
    },
    {
      "operation": "step_group",
      "isServer": true,
      "args": {
        "role": "*",
        "message": "",
        "timer": "24",
        "isInteractive": false,
        "canTerminate": false,
        "success": [
          {
            "operation": "app_services",
            "isServer": true,
            "args": {
              "cmd": "stop_app_diagram",
              "pdalias": "${alias}"
            }
          }
        ]
      }
    },
    {
      "operation": "end",
      "isServer": true,
      "args": null
    }
  ],
  "externalForms": {}
}
